{
  "name": "@ritualdev-lab/mcp-builder-kit",
  "version": "1.2.3",
  "description": "Production Toolkit & Scaffolding Engine for Model Context Protocol (MCP) Servers",
  "type": "module",
  "bin": {
    "mcp-builder-kit": "./dist/cli.js",
    "mcp-builder": "./dist/cli.js",
    "mcp-kit": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE", "SKILL.md"],
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RitualDev-Lab/mcp-builder-kit.git"
  },
  "homepage": "https://github.com/RitualDev-Lab/mcp-builder-kit#readme",
  "bugs": {
    "url": "https://github.com/RitualDev-Lab/mcp-builder-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test",
    "benchmark": "tsx src/cli.ts benchmark",
    "prepublishOnly": "pnpm run build && pnpm test && npm pack --dry-run",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agent",
    "claude-desktop",
    "antigravity",
    "cursor",
    "stdio",
    "sse",
    "scaffolding",
    "toolkit"
  ],
  "author": "RitualDev Lab (https://github.com/RitualDev-Lab)",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^4.6.7"
  }
}
